# Use the Windows Wi-Fi IPv4 address configured in config/wifi_secrets.h.
MQTT_BROKER_IP=
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=mtk3smp-pico
DASHBOARD_PORT=8501

# Optional. Set a unique value of at least 32 hex digits for course setup.
# MQTT_ROUTE_PASSWORD=

# Optional if Mosquitto is outside PATH and its usual install directory.
# Use a full path without quotes.
# MOSQUITTO_EXE=C:\Program Files\mosquitto\mosquitto.exe
